---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  activeCategory?: string;
}

const { title, description, activeCategory = 'Developer' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="relative min-h-screen bg-[#0c1222] text-slate-100 selection:bg-emerald-500 selection:text-black">
    
    <!-- 1. Full-Width Scenic Hero Backdrop with Smooth Fade -->
    <div class="absolute top-0 left-0 right-0 h-[620px] overflow-hidden pointer-events-none -z-10">
      <!-- Background Image -->
      <img
        src="/images/hero-bg.webp"
        alt="Atmospheric Landscape Background"
        class="w-full h-full object-cover object-top opacity-65"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Gradient Overlays to seamlessly blend into #0c1222 -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#0c1222] via-[#0c1222]/40 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#0c1222]/30 via-transparent to-[#0c1222]"></div>
    </div>

    <!-- 2. Sticky Glass Header -->
    <header class="max-w-7xl mx-auto px-4 sm:px-6 pt-5">
      <nav class="backdrop-blur-xl bg-slate-900/50 border border-white/10 rounded-2xl px-5 py-3 flex items-center justify-between shadow-2xl">
        <div class="flex items-center gap-8">
          <a href="/" class="flex items-center gap-2 font-bold text-lg tracking-tight text-white hover:text-emerald-400 transition-colors">
            <span class="bg-white/10 p-1.5 rounded-lg text-emerald-400 font-mono text-sm">&lt;/&gt;</span>
            SiteOfTools
          </a>
          <div class="hidden md:flex items-center gap-6 text-xs font-medium text-slate-300">
            <a href="/" class="hover:text-white transition-colors">Tools</a>
            <a href="#" class="hover:text-white transition-colors">Categories</a>
            <a href="#" class="hover:text-white transition-colors">Favorites</a>
            <a href="#" class="hover:text-white transition-colors">About</a>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="relative hidden sm:block">
            <input
              type="text"
              placeholder="Search tools... (/)"
              class="bg-slate-950/60 border border-white/10 rounded-xl px-3.5 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500/50 w-52"
            />
            <kbd class="absolute right-2.5 top-2 text-[10px] text-slate-500 bg-white/5 px-1.5 py-0.5 rounded border border-white/10">/</kbd>
          </div>
          <span class="text-[11px] font-mono bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 px-2.5 py-1 rounded-full">
            🔒 Private
          </span>
        </div>
      </nav>
    </header>

    <!-- 3. Dynamic Page Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 pb-16">
      <slot />
    </main>

    <!-- 4. Footer -->
    <footer class="max-w-7xl mx-auto px-4 sm:px-6 py-8 border-t border-white/5 text-center text-xs text-slate-500">
      <p>© {new Date().getFullYear()} SiteOfTools.com — 100% Client-Side In-Browser Developer Utility Suite.</p>
    </footer>
  </body>
</html>