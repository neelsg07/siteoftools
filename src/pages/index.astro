---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOL_REGISTRY } from '../data/toolsMap';

const tools = Object.values(TOOL_REGISTRY);
---

<BaseLayout
  title="SiteOfTools — Fast, Private In-Browser Developer Utility Suite"
  description="Collection of fast, lightweight developer utilities running 100% client-side with zero data retention."
  activeCategory="Developer"
>
  <div class="space-y-6">
    <div class="flex items-center justify-between pb-2 border-b border-black/10 dark:border-white/10">
      <h2 class="text-sm font-bold uppercase tracking-wider text-neutral-500">Popular Tools</h2>
      <span class="text-xs text-neutral-500 font-mono">{tools.length} Tools Available</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {tools.map((tool) => (
        <a
          href={tool.status === 'ready' ? tool.href : '#'}
          class={`group backdrop-blur-xl bg-white/80 dark:bg-neutral-900/80 border border-black/10 dark:border-white/10 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between ${
            tool.status === 'coming-soon' ? 'opacity-60 cursor-not-allowed' : 'hover:border-black dark:hover:border-white'
          }`}
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-lg font-mono p-2 rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-900 dark:text-white">
                {tool.icon || '< >'}
              </span>
              <span class={`text-[10px] font-mono px-2 py-0.5 rounded-full border ${
                tool.status === 'ready'
                  ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20'
                  : 'bg-neutral-100 dark:bg-neutral-800 text-neutral-500 border-black/5 dark:border-white/5'
              }`}>
                {tool.status === 'ready' ? 'Ready' : 'Coming Soon'}
              </span>
            </div>
            <h3 class="font-bold text-neutral-900 dark:text-white group-hover:text-black dark:group-hover:text-neutral-100 mb-1">
              {tool.name}
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
              {tool.description}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-black/5 dark:border-white/5 flex items-center justify-between text-[11px] font-medium text-neutral-500">
            <span>{tool.category}</span>
            <span class="group-hover:translate-x-0.5 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>