---
import ToolLayout from '../layouts/ToolLayout.astro';
import TextDiffTool from '../components/tools/text/TextDiffTool';

const relatedTools = ['text-diff', 'json-diff', 'list-compare', 'base64-tool'];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does this Text Diff Checker work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The tool uses a diffing algorithm to compare two blocks of text line by line. It identifies identical strings and flags exact additions in green and deletions in red, allowing you to quickly spot revisions between two document versions."
      }
    },
    {
      "@type": "Question",
      "name": "Is my text data stored on a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The entire comparison process is executed locally in your web browser. We do not use databases or cloud servers to process your inputs, ensuring that confidential code or private documents remain completely secure."
      }
    },
    {
      "@type": "Question",
      "name": "Can I compare code snippets as well as plain text?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, this utility treats all inputs as raw strings, making it perfect for comparing programming code, HTML, system logs, YAML configuration files, and standard prose or essays."
      }
    }
  ]
};
---

<ToolLayout
  title="Text Diff Checker — Compare Text Files & Code Online"
  description="Compare two blocks of text or code snippets line by line. Fast, secure, and entirely client-side text diff tool for identifying additions and deletions."
  toolName="Text Diff Checker"
  category="Text"
  relatedToolIds={relatedTools}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <TextDiffTool client:load />

  <article class="mt-16 border-t border-black/10 dark:border-white/10 pt-10 text-neutral-800 dark:text-neutral-200 space-y-8 text-xs leading-relaxed">
    
    <header class="space-y-3">
      <h2 class="text-base font-bold text-neutral-900 dark:text-white">
        Free Online Text Diff Checker
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400 text-[13px] leading-loose">
        Whether you are a developer conducting a code review, an editor proofreading manuscript revisions, or a system administrator auditing raw log files, manually spotting differences between two large blocks of text is tedious and prone to error. Our Text Diff Checker provides an instant, side-by-side visual breakdown of exactly what changed between an original document and its modified version. By highlighting additions, deletions, and preserved content line by line, you can verify changes with absolute precision.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-5 rounded-xl bg-neutral-100/70 dark:bg-neutral-900/60 border border-black/5 dark:border-white/5 space-y-2">
        <h3 class="font-bold text-neutral-900 dark:text-white text-sm">Git-Style Comparison Layouts</h3>
        <p class="text-neutral-600 dark:text-neutral-400">
          Tailor your review experience by toggling between two distinct viewing modes. The <strong>Side-by-Side view</strong> splits the screen vertically, placing original and modified text parallel to each other—ideal for wide screens and code blocks. The <strong>Unified view</strong> merges the texts into a single scrolling window, making it highly effective for reading paragraph changes on mobile devices or smaller monitors.
        </p>
      </div>
      <div class="p-5 rounded-xl bg-neutral-100/70 dark:bg-neutral-900/60 border border-black/5 dark:border-white/5 space-y-2">
        <h3 class="font-bold text-neutral-900 dark:text-white text-sm">Zero-Tracking Privacy Guarantee</h3>
        <p class="text-neutral-600 dark:text-neutral-400">
          We understand that text comparisons often involve proprietary source code, legal contracts, or confidential business communications. This utility guarantees data sovereignty by executing the diff algorithm 100% locally within your device's browser. Your sensitive text is never sent over a network, stored in a database, or exposed to third-party tracking scripts.
        </p>
      </div>
    </div>

    <section class="space-y-4">
      <h3 class="text-sm font-bold text-neutral-900 dark:text-white">
        Who Uses a Text Comparator?
      </h3>
      <ul class="list-disc pl-5 space-y-2 text-neutral-600 dark:text-neutral-400 text-[13px] leading-loose">
        <li><strong>Software Engineers & QA:</strong> Validate logic changes in raw source code snippets, troubleshoot formatting alterations in HTML/CSS, or compare multiline Git commit logs.</li>
        <li><strong>Technical Writers & Editors:</strong> Review editorial revisions, track copy edits across multiple drafts, and ensure no critical paragraphs were accidentally deleted during formatting.</li>
        <li><strong>System Administrators:</strong> Compare environment variables, audit <code>.env</code> file changes, or cross-reference massive server access logs to spot anomalies.</li>
        <li><strong>Legal & Compliance Teams:</strong> Quickly verify that standardized contract clauses match approved templates without reading hundreds of pages manually.</li>
      </ul>
    </section>

    <section class="space-y-4 border-t border-black/5 dark:border-white/5 pt-8">
      <h3 class="text-sm font-bold text-neutral-900 dark:text-white">
        Frequently Asked Questions
      </h3>
      <dl class="space-y-4">
        <div class="bg-neutral-50 dark:bg-neutral-900/40 p-4 rounded-lg">
          <dt class="font-bold text-neutral-900 dark:text-white">How does this differ from the JSON Diff tool?</dt>
          <dd class="text-neutral-600 dark:text-neutral-400 mt-1.5 leading-relaxed">
            The JSON Diff tool includes a pre-processing engine that parses, validates, and automatically formats structured JSON data before comparing it. This Text Diff tool skips the parsing step entirely, applying a raw string comparison that preserves your exact original line breaks, tabs, and spaces.
          </dd>
        </div>
        <div class="bg-neutral-50 dark:bg-neutral-900/40 p-4 rounded-lg">
          <dt class="font-bold text-neutral-900 dark:text-white">Is there a size limit for the text comparison?</dt>
          <dd class="text-neutral-600 dark:text-neutral-400 mt-1.5 leading-relaxed">
            Because the computation runs exclusively on your local machine, the only limitation is your device's available RAM. You can comfortably compare thousands of lines of text or code without experiencing the latency typical of server-side applications.
          </dd>
        </div>
      </dl>
    </section>

  </article>
</ToolLayout>